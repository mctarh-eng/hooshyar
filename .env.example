# ─────────────────────────────────────────────────────────────
#  هوش‌یار — نمونه‌ی فایل تنظیمات
#  کپی کن:  cp .env.example .env   و مقادیر را پر کن
# ─────────────────────────────────────────────────────────────

# ۱) اعتبارنامه‌ی موتور هوش مصنوعی (سرور از آن برای چت/تصویر/صدا استفاده می‌کند)
#    این مقادیر هنگام اجرای داکر به‌صورت خودکار به .z-ai-config تبدیل می‌شوند
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_API_KEY="your-api-key-here"

# ۲) دیتابیس (در داکر لازم نیست — خودکار تنظیم می‌شود)
# DATABASE_URL="file:./db/custom.db"

# ۳) آدرس عمومی وب‌اپ (فقط برای ساخت APK — در گیت‌هاب هم به‌عنوان
#    Variable با همین نام ثبت می‌شود)
CAP_SERVER_URL="https://your-domain.example.com"
